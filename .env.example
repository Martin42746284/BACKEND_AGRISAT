DATABASE_URL=postgresql://neondb_owner:VOTRE_MOT_DE_PASSE@VOTRE_ENDPOINT_NEON/neondb?sslmode=require&channel_binding=require
# Delai maximal de la requete parcelles a la base (secondes). 60 s convient a
# une base distante (Neon) ou a un lien lent : la requete charge 37 colonnes
# dont des JSONB volumineux, et au-dela du delai le cache parcelles repond 503
# au lieu de servir les parcelles.
PARCELS_QUERY_TIMEOUT_S=60
GEE_SERVICE_ACCOUNT_KEY={}
HF_MODEL_URL=https://andritinatonny-agrisat.hf.space
# Modèle YOLO de segmentation de parcelles embarqué dans le backend (aucune API).
# Utilisé par /api/field-segmentation. Vide : poids fournis dans
# app/data/models/field_segmentation/parcel_segmentation_yolo.pt
# FIELD_SEGMENTATION_MODEL_PATH=
# Seuil du masque renvoye quand la requete n'en fournit pas. 0.1 = confiance de
# production du projet source ; au-dela le masque devient quasi vide (les
# confiances du modele sont faibles : mediane ~0.2 sur les tuiles JECAM).
# FIELD_SEGMENTATION_THRESHOLD=0.1
# Prechauffage des modeles au demarrage (~20 s : import torch + premier passage).
# false = demarrage/reload immediat, premier appel de segmentation plus lent.
# WARMUP_MODELS=true
# Tracage automatique des parcelles (modele JECAM sur image THR), utilise par
# /api/zone-parcels. En local : cd agri_field_segmentation && python src/serve_vhr.py
VHR_MODEL_URL=http://localhost:8010
# Auto-start du service de tracage par le backend : dossier du projet
# agri_field_segmentation. Au demarrage, le backend verifie /health et lance
# tout seul src/serve_vhr.py (detache, modele delineate_jecam_complet.pt) si le
# service ne repond pas deja. Laisser vide pour garder le demarrage manuel.
# VHR_SERVICE_PYTHON (optionnel) : python a utiliser ; defaut : le venv du
# service s'il existe (.venv/Scripts/python.exe), sinon le python du backend.
VHR_SERVICE_DIR=D:/ASA/martin/agri_field_segmentation
# VHR_SERVICE_PYTHON=
# VHR_SERVICE_PORT=8010
GOOGLE_MAPS_API_KEY=your-google-maps-key
# Détection de parcelles par Gemini (POST /api/gemini-parcels).
# Clé distincte de la clé Maps : une clé Google Maps n'a pas accès à l'API
# Generative Language (403 API_KEY_SERVICE_BLOCKED). Créez une clé sur
# https://aistudio.google.com/apikey et collez-la ici.
GEMINI_API_KEY=your-gemini-api-key
# Modèle utilisé (défaut : gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Mode de détection :
#   image (défaut) : Gemini DESSINE les limites en rouge sur la photo, que le
#                    backend reconvertit en parcelles ; les contours épousent le
#                    parcellaire réel.
#   text           : Gemini énumère les contours en coordonnées JSON — approximatif,
#                    conservé en repli.
# GEMINI_PARCELS_MODE=image
# Modèle image utilisé quand GEMINI_PARCELS_MODE=image.
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Largeur visée de la capture autour du centre de la carte, en mètres.
# GEMINI_CAPTURE_SPAN_M=100
# Largeur d'une tuile de la mosaïque : 20 m conserve le détail métrique demandé.
# GEMINI_CAPTURE_TILE_SPAN_M=20
# Nombre maximal de tuiles par côté (5 => mosaïque 5x5, soit 25 requêtes).
# GEMINI_CAPTURE_MAX_TILES=5
# Délai maximal de l'appel Gemini, en secondes.
# GEMINI_TIMEOUT_S=150
# Clé API OneAtlas (Airbus) - portail développeur : https://data.intelligence-airbus.com
AIRBUS_ONEATLAS_API_KEY=your-airbus-oneatlas-api-key
PORT=3001
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:8080
PLANET_API_KEY=
